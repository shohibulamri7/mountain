--  FITUR 3 : Fast Pickup (reparent Tool ke Backpack paksa)
-- ════════════════════════════════════════════════════════════════
local pickupActive = false
local pickupTotal  = 0

-- Cari Tools di Workspace dalam radius tertentu
local function findGroundItems(wantRune, wantCrystal, radius)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local pos  = root.Position
    local list = {}

    local function scanParent(parent, depth)
        if depth > 7 then return end
        local ok2, children = pcall(parent.GetChildren, parent)
        if not ok2 then return end
        for _, obj in ipairs(children) do
            if obj:IsA("Tool") then
                -- hanya item di lantai (bukan di inventory siapapun)
                local inPlayer = false
                pcall(function()
                    local p = obj.Parent
                    if p and (p:IsA("Backpack") or p:IsA("StarterGear")) then
                        inPlayer = true
                    end
                    if p and Players:GetPlayerFromCharacter(p) then
                        inPlayer = true
                    end
                end)
                if not inPlayer then
                    local rune   = isRune(obj)
                    local cryst  = isCrystal(obj)
                    if (wantRune and rune) or (wantCrystal and cryst) then
                        local part = obj:FindFirstChildOfClass("BasePart")
                            or obj:FindFirstChildOfClass("MeshPart")
                            or obj:FindFirstChildOfClass("Part")
                        if part then
                            local dist = (part.Position - pos).Magnitude
                            if dist <= radius then
                                list[#list + 1] = {tool = obj, dist = dist}
                            end
                        end
                    end
                end
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scanParent(obj, depth + 1)
            end
        end
    end

    scanParent(workspace, 0)
    table.sort(list, function(a, b) return a.dist < b.dist end)

    local result = {}
    for _, v in ipairs(list) do result[#result + 1] = v.tool end
    return result
end

-- Coba berbagai metode pickup
local function tryPickup(tool)
    if not tool or not tool.Parent then return end

    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return end

    -- Metode 1: reparent langsung (exploit)
    local ok = pcall(function() tool.Parent = bp end)
    if ok and tool.Parent == bp then return end

    -- Metode 2: dekat karakter lalu trigger TouchTransmitter
    pcall(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local part = tool:FindFirstChildOfClass("BasePart")
                or tool:FindFirstChildOfClass("MeshPart")
                or tool:FindFirstChildOfClass("Part")
            if part then
                -- teleport item ke posisi karakter agar trigger Touch
                part.CFrame = root.CFrame * CFrame.new(0, 0, -1)
            end
        end
    end)

    -- Metode 3: FireServer melalui RemoteEvent pickup jika ada
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        for _, v in ipairs(rs:GetDescendants()) do
            if v:IsA("RemoteEvent") and
               (v.Name:lower():find("pickup") or v.Name:lower():find("collect")) then
                v:FireServer(tool)
                break
            end
        end
    end)
end

local function startPickup(wantRune, wantCrystal, radius, intervalMs, onStatus)
    if pickupActive then return end
    pickupActive = true
    pickupTotal  = 0

    task.spawn(function()
        while pickupActive do
            local items = findGroundItems(wantRune, wantCrystal, radius)
            for _, tool in ipairs(items) do
                if not pickupActive then break end
                tryPickup(tool)
                pickupTotal = pickupTotal + 1
                task.wait(0.005) -- 5 ms antar item saat pickup batch
            end
            if onStatus then
                onStatus(string.format(
                    "🧲 Aktif | radius %.0f | didapat: %d",
                    radius, pickupTotal
                ))
            end
            task.wait(math.max(intervalMs, 50) / 1000)
        end
        if onStatus then
            onStatus(string.format("■ Dihentikan | total: %d item", pickupTotal))
        end
    end)
end

local function stopPickup() pickupActive = false end

