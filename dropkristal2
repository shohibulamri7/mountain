-- ──────────────────────────────────────────────────────────
--  Fungsi utama DROP SEMUA dalam 5 detik
-- ──────────────────────────────────────────────────────────
local sedangDrop = false

local function dropSemua(alasan)
    if sedangDrop then return end
    sedangDrop = true
    sudahDrop  = true

    local kristal = ambilSemuaKristal()
    local jumlah  = #kristal

    -- Update status
    local function setStatus(text, warna)
        pcall(function()
            statusLabel.Text       = text
            statusLabel.TextColor3 = warna or Color3.fromRGB(160, 160, 180)
        end)
    end

    if jumlah == 0 then
        setStatus("Tidak ada kristal!", Color3.fromRGB(255, 180, 60))
        task.delay(2, function()
            sedangDrop = false
            sudahDrop  = false
            setStatus("Siap — klik tombol untuk drop")
            btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
            btn.Text = "DROP SEMUA KRISTAL (5 detik)"
            btn.Active = true
        end)
        return
    end

    -- Nonaktifkan tombol selama proses
    btn.Active = false
    btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)

    print(string.format("[AutoDrop] Drop %d kristal dalam 5 detik... (%s)", jumlah, alasan))

    -- Unequip dulu
    pcall(function()
        local char     = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:UnequipTools() end
    end)

    -- Posisi jatuh dari kaki karakter
    local root = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local pusatPos = root and root.Position or Vector3.new(0, 5, 0)

    -- Jeda antar drop agar selesai dalam 5 detik
    local BATAS    = 5.0
    local jedaDrop = math.max(0.05, math.min(BATAS / jumlah, 0.4))
    local mulai    = os.clock()

    task.spawn(function()
        for i, tool in ipairs(kristal) do
            local elapsed = os.clock() - mulai
            if elapsed >= BATAS then
                setStatus(string.format("Waktu habis! Sisa %d", jumlah - i + 1), Color3.fromRGB(255, 100, 60))
                break
            end

            -- Posisi menyebar melingkar
            local sudut    = (i - 1) * (math.pi * 2 / jumlah)
            local posJatuh = pusatPos + Vector3.new(
                math.cos(sudut) * 2.5,
                0.3,
                math.sin(sudut) * 2.5
            )

            dropSatu(tool, posJatuh)

            -- Update tombol dengan countdown
            local sisaWaktu = math.max(0, BATAS - (os.clock() - mulai))
            pcall(function()
                btn.Text = string.format("Drop %d/%d  (%.1fs)", i, jumlah, sisaWaktu)
            end)
            setStatus(string.format("Menjatuhkan %d/%d kristal...", i, jumlah), Color3.fromRGB(100, 220, 100))

            task.wait(jedaDrop)
        end

        -- Selesai
        local totalWaktu = os.clock() - mulai
        print(string.format("[AutoDrop] Selesai: %d kristal di-drop dalam %.2f detik", jumlah, totalWaktu))
        setStatus(string.format("✓ %d kristal dijatuhkan (%.1fs)", jumlah, totalWaktu), Color3.fromRGB(80, 220, 100))

        btn.Text             = "DROP SEMUA KRISTAL (5 detik)"
        btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        btn.Active           = true
        sedangDrop           = false

        -- Reset flag setelah 3 detik agar bisa dipakai lagi
        task.delay(3, function() sudahDrop = false end)
    end)
end

-- ──────────────────────────────────────────────────────────
--  Hover effect tombol
-- ──────────────────────────────────────────────────────────
btn.MouseEnter:Connect(function()
    if not sedangDrop then
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        }):Play()
    end
end)

btn.MouseLeave:Connect(function()
    if not sedangDrop then
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        }):Play()
    end
end)

-- ──────────────────────────────────────────────────────────
--  Klik tombol → drop
-- ──────────────────────────────────────────────────────────
btn.MouseButton1Click:Connect(function()
    dropSemua("Tombol GUI")
end)

-- ──────────────────────────────────────────────────────────
--  AUTO TRIGGER saat disconnect / login ganda
-- ──────────────────────────────────────────────────────────
conns[1] = LocalPlayer.CharacterRemoving:Connect(function()
    if not sudahDrop then
        dropSemua("CharacterRemoving — disconnect / login ganda")
    end
end)

conns[2] = LocalPlayer.CharacterAdded:Connect(function()
    task.delay(3, function()
        sudahDrop  = false
        sedangDrop = false
        pcall(function()
            statusLabel.Text       = "Siap — klik tombol untuk drop"
            statusLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
            btn.Text             = "DROP SEMUA KRISTAL (5 detik)"
            btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
            btn.Active           = true
        end)
    end)
end)

conns[3] = Players.PlayerRemoving:Connect(function(player)
    if player == LocalPlayer and not sudahDrop then
        dropSemua("PlayerRemoving — keluar server")
    end
end)

conns[4] = GuiService.ErrorMessageChanged:Connect(function()
    local ok, msg = pcall(function() return GuiService:GetErrorMessage() end)
    if ok and type(msg) == "string" and msg ~= "" and not sudahDrop then
        dropSemua("Kicked: " .. msg:sub(1, 30))
    end
end)

pcall(function()
    local gui     = CoreGui:FindFirstChild("RobloxPromptGui")
    local overlay = gui and gui:FindFirstChild("promptOverlay")
    if overlay then
        conns[5] = overlay.ChildAdded:Connect(function(child)
            if (child.Name:find("Error") or child.Name:find("Disconnect")) and not sudahDrop then
                dropSemua("Popup: " .. child.Name)
            end
        end)
    end
end)

-- ──────────────────────────────────────────────────────────
--  Cleanup
-- ──────────────────────────────────────────────────────────
local function cleanup()
    for _, c in ipairs(conns) do
        if c then pcall(function() c:Disconnect() end) end
    end
    table.clear(conns)
    pcall(function() screenGui:Destroy() end)
    print("[AutoDrop] Unloaded.")
end

local getgenv = getgenv or function() return _G end
getgenv().AutoDropUnload = cleanup

print("[AutoDrop] Aktif! GUI muncul di layar kiri atas.")
