-- VirtualInputManager untuk simulasi Backspace server-side
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

-- ── Attr helper ──
local function attr(inst, name)
    if not inst then return nil end
    local ok, v = pcall(inst.GetAttribute, inst, name)
    return ok and v or nil
end

local function crVal(t)  return tonumber(attr(t,"Value"))    or 0 end
local function crTier(t) return tonumber(attr(t,"Tier"))     or 0 end
local function crMut(t)
    local m = attr(t,"Mutation")
    return type(m)=="string" and m~="" and m~="None"
end
local function crName(t)
    local n = attr(t,"CrystalName")
    return (type(n)=="string" and n~="") and n or t.Name
end

-- Format angka singkat
local function fmt(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return string.format("%.1fT",n/1e12)
    elseif n >= 1e9  then return string.format("%.1fB",n/1e9)
    elseif n >= 1e6  then return string.format("%.1fM",n/1e6)
    elseif n >= 1e3  then return string.format("%.1fk",n/1e3)
    else return tostring(math.floor(n)) end
end

-- Parse "2m" → 2000000
local function parse(s)
    if type(s)~="string" then return nil end
    s = s:lower():gsub("[%s,$]","")
    local n,sf = s:match("^(%d*%.?%d+)(%a*)$")
    if not n then return nil end
    n = tonumber(n)
    local mul = {k=1e3,m=1e6,b=1e9,t=1e12}
    return n * (mul[sf] or 1)
end

-- ── Scan kristal di inventory ──
local function getInventory()
    local list = {}
    local function scan(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and attr(t,"Tier") ~= nil then
                list[#list+1] = t
            end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"))
    scan(LP.Character)
    return list
end

-- ── Build daftar kristal yang akan di-drop (pakai filter) ──
local function buildDropList(maxVal, protectMut)
    local all = getInventory()
    local list = {}
    for _, t in ipairs(all) do
        local v = crVal(t)
        if v <= maxVal then
            if protectMut and crMut(t) then
                -- skip mutasi
            else
                list[#list+1] = t
            end
        end
    end
    -- Sort: nilai terkecil dulu
    table.sort(list, function(a,b) return crVal(a) < crVal(b) end)
    return list
end

-- ── Drop satu tool: equip → Backspace ──
local function dropOne(tool)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    -- Equip
    local ok = pcall(hum.EquipTool, hum, tool)
    if not ok then return false end
    task.wait(0.006)  -- sedikit jeda setelah equip agar server menerima

    -- Backspace via VirtualInputManager (server-side, terlihat semua player)
    if VIM then
        pcall(function()
            VIM:SendKeyEvent(true,  Enum.KeyCode.Backspace, false, game)
            task.wait(0.001)
            VIM:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
        end)
        return true
    end

    -- Fallback: simulasi keydown via UIS (beberapa executor support)
    pcall(function()
        local f = Instance.new("InputObject")
        f.KeyCode       = Enum.KeyCode.Backspace
        f.UserInputType = Enum.UserInputType.Keyboard
        f.UserInputState= Enum.UserInputState.Begin
        UIS.InputBegan:Fire(f, false)
        task.wait(0.001)
        f.UserInputState = Enum.UserInputState.End
        UIS.InputEnded:Fire(f, false)
    end)
    return true
end

-- ── Drop semua yang sesuai filter ──
local dropping = false

local function dropAll(maxVal, protectMut, delay, onStatus)
    if dropping then return end
    dropping = true

    local list = buildDropList(maxVal, protectMut)

    if #list == 0 then
        dropping = false
        if onStatus then onStatus("Tidak ada kristal yang sesuai filter") end
        return 0
    end

    if onStatus then onStatus(string.format("Mulai drop %d kristal...", #list)) end
    task.wait(0.1)

    local count = 0
    for i, tool in ipairs(list) do
        if not dropping then break end
        if tool and tool.Parent then
            if onStatus then onStatus(string.format("Drop %d/%d  %s ($%s)", i, #list, crName(tool), fmt(crVal(tool)))) end
            dropOne(tool)
            count = count + 1
            task.wait(delay)
        end
    end

    dropping = false
    if onStatus then onStatus(string.format("Selesai! %d kristal di-drop", count)) end
    return count
end

