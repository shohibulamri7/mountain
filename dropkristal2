-- ──────────────────────────────────────────────────────────
--  Deteksi kristal
-- ──────────────────────────────────────────────────────────
local function adalahKristal(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local function attr(nama)
        local ok, v = pcall(tool.GetAttribute, tool, nama)
        return ok and v ~= nil
    end
    return attr("Value") or attr("Tier") or attr("WeightKg")
        or tool.Name:find("Crystal", 1, true) ~= nil
end

local function ambilSemuaKristal()
    local list = {}
    local function scan(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if adalahKristal(child) then list[#list + 1] = child end
        end
    end
    scan(LocalPlayer.Character)
    scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
    return list
end

-- ──────────────────────────────────────────────────────────
--  Drop satu kristal ke posisi tertentu
-- ──────────────────────────────────────────────────────────
local function dropSatu(tool, posisi)
    if not tool or not tool.Parent then return end
    local handle = tool:FindFirstChild("Handle")
        or tool:FindFirstChildWhichIsA("BasePart")
    if handle then
        pcall(function()
            handle.CFrame   = CFrame.new(posisi)
            handle.Anchored = false
        end)
    end
    pcall(function() tool.Parent = Workspace end)
end

