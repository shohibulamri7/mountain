-- ─── Cek apakah item adalah kristal ──────────────────────
local function isKristal(item)
    if not item or not item:IsA("Tool") then return false end
    local nama = item.Name:lower()
    if nama:find("crystal") or nama:find("kristal") then return true end
    -- Cek atribut Value / Tier (biasa di game crystal)
    local ok1, v1 = pcall(function() return item:GetAttribute("Value") end)
    if ok1 and v1 ~= nil then return true end
    local ok2, v2 = pcall(function() return item:GetAttribute("Tier") end)
    if ok2 and v2 ~= nil then return true end
    return false
end

-- ─── Kumpulkan kristal ───────────────────────────────────
local function getKristals()
    local list = {}
    local char = lp.Character
    local bp   = lp:FindFirstChildOfClass("Backpack")
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if isKristal(v) then table.insert(list, v) end
        end
    end
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if isKristal(v) then table.insert(list, v) end
        end
    end
    return list
end

-- ─── Drop 1 kristal (metode paling simpel) ───────────────
local function dropSatu(tool)
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    -- Equip dulu supaya tool masuk ke karakter
    hum:EquipTool(tool)
    task.wait(0.15)

    -- Pindahkan ke Workspace = drop
    tool.Parent = game.Workspace
    task.wait(0.1)
    return true
end

