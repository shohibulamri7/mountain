local function mkBtn(t,c,o,fn)
    local b=Instance.new("TextButton"); b.LayoutOrder=o; b.Size=UDim2.new(1,0,0,32)
    b.BackgroundColor3=c; b.Text=t; b.TextColor3=WHITE; b.Font=Enum.Font.GothamBold
    b.TextSize=12; b.BorderSizePixel=0; b.Parent=Sc
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)
    b.MouseButton1Click:Connect(fn); return b
end
local function mkSep(o)
    local s=Instance.new("Frame"); s.LayoutOrder=o; s.Size=UDim2.new(1,0,0,1)
    s.BackgroundColor3=SEP; s.BorderSizePixel=0; s.Parent=Sc
end

