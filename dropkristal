-- DropSemua v5 - Simple, bertahap, anti error

local lp        = game.Players.LocalPlayer
local CoreGui   = game:GetService("CoreGui")

local dropping  = false
local btnRef    = nil

-- Hapus GUI lama
if CoreGui:FindFirstChild("DropGui") then
    CoreGui:FindFirstChild("DropGui"):Destroy()
end

-- ─── Buat GUI ────────────────────────────────────────────
local gui  = Instance.new("ScreenGui")
gui.Name         = "DropGui"
gui.ResetOnSpawn = false
gui.Parent       = CoreGui

local frame = Instance.new("Frame")
frame.Size              = UDim2.new(0, 170, 0, 50)
frame.Position          = UDim2.new(1, -180, 1, -70)
frame.BackgroundColor3  = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel   = 0
frame.Parent            = gui

local c1 = Instance.new("UICorner")
c1.CornerRadius = UDim.new(0, 10)
c1.Parent = frame

local btn = Instance.new("TextButton")
btn.Size            = UDim2.new(1, -8, 1, -8)
btn.Position        = UDim2.new(0, 4, 0, 4)
btn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
btn.Text            = "🎒 DROP KRISTAL"
btn.TextColor3      = Color3.new(1,1,1)
btn.TextSize        = 15
btn.Font            = Enum.Font.GothamBold
btn.AutoButtonColor = false
btn.BorderSizePixel = 0
btn.Parent          = frame
btnRef = btn

local c2 = Instance.new("UICorner")
c2.CornerRadius = UDim.new(0, 7)
c2.Parent = btn

-- ─── Logika Drop ─────────────────────────────────────────
local function doDropAll()
    if dropping then return end
    dropping = true

    -- Kumpulkan semua tool dari karakter + backpack
    local tools = {}

    local char = lp.Character
    if char then
        -- Unequip dulu
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:UnequipTools() end
        task.wait(0.1)

        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then
                table.insert(tools, v)
            end
        end
    end

    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") then
                table.insert(tools, v)
            end
        end
    end

    if #tools == 0 then
        btn.Text = "Tas kosong!"
        task.wait(1.5)
        btn.Text = "🎒 DROP KRISTAL"
        dropping = false
        return
    end

    -- Drop satu per satu
    for i, tool in ipairs(tools) do
        btn.Text = i .. " / " .. #tools

        -- Dapatkan posisi pemain saat ini
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local basePos = hrp and hrp.Position or Vector3.new(0, 10, 0)

        -- Pindahkan tool ke Workspace
        tool.Parent = game.Workspace

        -- Cari Handle
        local handle = tool:FindFirstChild("Handle")
        if not handle then
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then
                    handle = part
                    break
                end
            end
        end

        -- Set posisi di atas pemain agar tidak tembus lantai
        if handle then
            handle.Anchored   = true
            handle.CanCollide = true

            local angle = (i / #tools) * 2 * math.pi
            handle.CFrame = CFrame.new(
                basePos.X + math.cos(angle) * 2,
                basePos.Y + 4,
                basePos.Z + math.sin(angle) * 2
            )

            task.wait(0.05)
            handle.Anchored = false
        end

        -- Jeda antar item (ubah angka ini untuk lebih cepat/lambat)
        task.wait(0.1)
    end

    btn.Text = "✅ Selesai!"
    task.wait(2)
    btn.Text = "🎒 DROP KRISTAL"
    dropping = false
end

-- Event klik tombol
btn.MouseButton1Click:Connect(function()
    task.spawn(doDropAll)
end)

print("DropSemua v5 aktif - tombol di kanan bawah")
