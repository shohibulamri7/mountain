--[[
    DropSemua.lua  (v3 – satu-satu cepat, anti-underground)
    ─────────────────────────────────────────────────────────
    • Drop item SATU PER SATU dengan jeda 0.05 detik
    • Tombol menampilkan progress realtime  (misal: 3 / 10)
    • CanCollide = true  →  tidak tembus lantai
    • Anchor → set CFrame → unanchor  →  posisi aman
    • Spawn tepat di atas pemain
]]

local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local CoreGui    = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local lp         = Players.LocalPlayer

-- ── Konfigurasi ──────────────────────────────────────────
local DELAY_PER_ITEM = 0.05   -- detik antar drop (ubah lebih kecil = lebih cepat)
local SPAWN_HEIGHT   = 4      -- studs di atas HRP saat spawn
local SCATTER_MIN    = 1.0    -- radius scatter minimum (studs)
local SCATTER_STEP   = 0.5    -- tambahan radius per slot

-- ── State ────────────────────────────────────────────────
local isDropping = false

-- ── Referensi tombol (diisi setelah GUI dibuat) ──────────
local btnRef = nil

local function setBtnText(txt)
    if btnRef and btnRef.Parent then
        btnRef.Text = txt
    end
end

-- ── Fungsi drop satu item ─────────────────────────────────
local function dropOne(tool, index, total)
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local basePos = hrp.Position

    -- Scatter melingkar merata berdasarkan urutan index
    local angle  = (index / total) * 2 * math.pi
    local radius = SCATTER_MIN + (index % 4) * SCATTER_STEP
    local spawnPos = Vector3.new(
        basePos.X + math.cos(angle) * radius,
        basePos.Y + SPAWN_HEIGHT,
        basePos.Z + math.sin(angle) * radius
    )

    -- Pindah ke Workspace
    tool.Parent = Workspace

    local part = tool:FindFirstChild("Handle")
             or tool.PrimaryPart
             or tool:FindFirstChildWhichIsA("BasePart")

    if part then
        part.Anchored   = true
        part.CanCollide = true
        part.CanTouch   = true
        part.CFrame     = CFrame.new(spawnPos)
        task.wait()            -- 1 frame agar CFrame terapply
        part.Anchored   = false
        -- Velocity kecil ke luar dari center
        local ox = math.cos(angle) * 3
        local oz = math.sin(angle) * 3
        part.AssemblyLinearVelocity = Vector3.new(ox, 2, oz)
    end
end

-- ── Fungsi utama ──────────────────────────────────────────
local function dropAll()
    if isDropping then return end
    isDropping = true

    local char    = lp.Character
    local backpack = lp:FindFirstChildOfClass("Backpack")
    local hrp     = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp then
        StarterGui:SetCore("SendNotification",{Title="Drop",Text="Karakter tidak ada!",Duration=2})
        isDropping = false
        setBtnText("🎒  DROP SEMUA")
        return
    end

    -- Unequip dulu
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end
    task.wait()

    -- Kumpulkan semua Tool
    local tools = {}
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then tools[#tools+1] = v end
    end
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then tools[#tools+1] = v end
        end
    end

    local total = #tools
    if total == 0 then
        StarterGui:SetCore("SendNotification",{Title="Drop",Text="Tas kosong!",Duration=2})
        isDropping = false
        setBtnText("🎒  DROP SEMUA")
        return
    end

    -- Drop satu per satu dengan delay
    for i, tool in ipairs(tools) do
        -- Update teks tombol jadi progress
        setBtnText(string.format("⏳  %d / %d", i, total))

        pcall(dropOne, tool, i, total)

        task.wait(DELAY_PER_ITEM)
    end

    -- Selesai
    setBtnText("✅  SELESAI!")
    StarterGui:SetCore("SendNotification",{
        Title = "Drop",
        Text  = total .. " item selesai di-drop!",
        Duration = 3
    })

    task.wait(1.5)
    setBtnText("🎒  DROP SEMUA")
    isDropping = false
end

-- ══════════════════════════════════════════════════════════
--  GUI
-- ══════════════════════════════════════════════════════════
local old = CoreGui:FindFirstChild("DropSemuaGui")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name           = "DropSemuaGui"
gui.ResetOnSpawn   = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent         = CoreGui

-- Frame
local frame = Instance.new("Frame")
frame.Size             = UDim2.new(0, 175, 0, 55)
frame.Position         = UDim2.new(1, -190, 1, -75)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel  = 0
frame.Parent           = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local stroke = Instance.new("UIStroke", frame)
stroke.Color     = Color3.fromRGB(255, 70, 70)
stroke.Thickness = 2

-- Tombol
local btn = Instance.new("TextButton")
btn.Size             = UDim2.new(1, -10, 1, -10)
btn.Position         = UDim2.new(0, 5, 0, 5)
btn.BackgroundColor3 = Color3.fromRGB(210, 35, 35)
btn.BorderSizePixel  = 0
btn.Text             = "🎒  DROP SEMUA"
btn.TextColor3       = Color3.new(1, 1, 1)
btn.TextSize         = 16
btn.Font             = Enum.Font.GothamBold
btn.AutoButtonColor  = false
btn.Parent           = frame
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

btnRef = btn   -- simpan referensi untuk update teks

btn.MouseEnter:Connect(function()
    if not isDropping then btn.BackgroundColor3 = Color3.fromRGB(255, 55, 55) end
end)
btn.MouseLeave:Connect(function()
    if not isDropping then btn.BackgroundColor3 = Color3.fromRGB(210, 35, 35) end
end)
btn.MouseButton1Down:Connect(function()
    if not isDropping then btn.BackgroundColor3 = Color3.fromRGB(140, 15, 15) end
end)
btn.MouseButton1Up:Connect(function()
    if not isDropping then btn.BackgroundColor3 = Color3.fromRGB(210, 35, 35) end
end)

btn.MouseButton1Click:Connect(function()
    task.spawn(dropAll)   -- jalankan di thread terpisah agar UI tidak freeze
end)

-- Tombol ×
local x = Instance.new("TextButton")
x.Size             = UDim2.new(0, 18, 0, 18)
x.Position         = UDim2.new(1, -20, 0, 2)
x.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
x.BorderSizePixel  = 0
x.Text             = "×"
x.TextColor3       = Color3.new(1, 1, 1)
x.TextSize         = 13
x.Font             = Enum.Font.GothamBold
x.ZIndex           = 5
x.Parent           = frame
Instance.new("UICorner", x).CornerRadius = UDim.new(1, 0)
x.MouseButton1Click:Connect(function() gui:Destroy() end)

print("[DropSemua v3] Siap — klik tombol kanan bawah.")
