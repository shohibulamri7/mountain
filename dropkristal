-- Cek firetouchinterest (executor function)
local hasFTI = (type(firetouchinterest) == "function")

-- ── Attr helper ──────────────────────────────────────────────────
local function attr(inst, name)
    if not inst then return nil end
    local ok, v = pcall(inst.GetAttribute, inst, name)
    return ok and v or nil
end

local function isRune(t)
    if not t or not t:IsA("Tool") then return false end
    if attr(t, "RuneType") ~= nil then return true end
    if attr(t, "Rune")     ~= nil then return true end
    if t.Name:lower():find("rune") then return true end
    return false
end

local function isCrystal(t)
    if not t or not t:IsA("Tool") then return false end
    return attr(t, "Tier") ~= nil
end

-- ── Cek apakah tool ada di inventory player (bukan lantai) ───────
local function isInInventory(tool)
    local p = tool.Parent
    if not p then return true end -- sudah ke-delete
    if p:IsA("Backpack") then return true end
    local plr = Players:GetPlayerFromCharacter(p)
    if plr then return true end
    return false
end

-- ── Simulasi key press ───────────────────────────────────────────
local function pressKey(keyCode, holdMs)
    holdMs = math.max(holdMs or 10, 1)
    if VIM then
        pcall(function()
            VIM:SendKeyEvent(true,  keyCode, false, game)
            task.wait(holdMs / 1000)
            VIM:SendKeyEvent(false, keyCode, false, game)
        end)
    else
        pcall(function()
            local inp = Instance.new("InputObject")
            inp.KeyCode        = keyCode
            inp.UserInputType  = Enum.UserInputType.Keyboard
            inp.UserInputState = Enum.UserInputState.Begin
            UIS.InputBegan:Fire(inp, false)
            task.wait(holdMs / 1000)
            inp.UserInputState = Enum.UserInputState.End
            UIS.InputEnded:Fire(inp, false)
        end)
    end
end

-- ── Equip tool ───────────────────────────────────────────────────
local function equipTool(tool)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return pcall(hum.EquipTool, hum, tool)
end

-- ── Scan inventory ───────────────────────────────────────────────
local function getInventory(filterFn)
    local list = {}
    local function scan(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (not filterFn or filterFn(t)) then
                list[#list + 1] = t
            end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"))
    if LP.Character then scan(LP.Character) end
    return list
end

-- ════════════════════════════════════════════════════════════════
--  CORE PICKUP — 4 metode bertingkat
-- ════════════════════════════════════════════════════════════════
local function pickupItem(tool)
    if not tool or not tool.Parent then return false end
    if isInInventory(tool) then return false end -- sudah di tas

    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Cari BasePart handle tool
    local handle = tool:FindFirstChild("Handle")
        or tool:FindFirstChildOfClass("BasePart")
        or tool:FindFirstChildOfClass("MeshPart")
        or tool:FindFirstChildOfClass("Part")

    -- ── Metode 1: firetouchinterest (paling efektif, executor support) ──
    if hasFTI and handle then
        pcall(function()
            firetouchinterest(handle, hrp, 0)
            task.wait(0.02)
            firetouchinterest(handle, hrp, 1)
        end)
        task.wait(0.03)
        if isInInventory(tool) then return true end
    end

    -- ── Metode 2: Teleport HRP ke item, trigger server Touch ──
    if handle then
        pcall(function()
            local savedCF = hrp.CFrame
            hrp.CFrame    = handle.CFrame * CFrame.new(0, 0.5, 0)
            task.wait(0.05)
            hrp.CFrame    = savedCF
        end)
        task.wait(0.05)
        if isInInventory(tool) then return true end
    end

    -- ── Metode 3: Teleport item ke HRP (item datang ke kita) ──
    if handle then
        pcall(function()
            local orig = handle.CFrame
            for _ = 1, 3 do
                handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -1)
                task.wait(0.05)
                if isInInventory(tool) then break end
            end
        end)
        task.wait(0.05)
        if isInInventory(tool) then return true end
    end

    -- ── Metode 4: Reparent paksa ke Backpack ──
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        pcall(function() tool.Parent = bp end)
        task.wait(0.03)
        if isInInventory(tool) then return true end
    end

    -- ── Metode 5: FireServer RemoteEvent pickup ──
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        for _, v in ipairs(rs:GetDescendants()) do
            if v:IsA("RemoteEvent") and
               (v.Name:lower():find("pickup") or
                v.Name:lower():find("collect") or
                v.Name:lower():find("grab")) then
                v:FireServer(tool)
                break
            end
        end
    end)

    return isInInventory(tool)
end

-- ════════════════════════════════════════════════════════════════
--  INSTANT PICKUP SYSTEM
--  Dua jalur: DescendantAdded (reaktif) + backup loop (sweeper)
-- ════════════════════════════════════════════════════════════════
local pickupActive   = false
local pickupTotal    = 0
local pickupConn     = nil   -- koneksi DescendantAdded
local pickupSweep    = nil   -- thread backup sweeper
local pickupRadius   = 20    -- studs, bisa diubah dari UI
local wantRune       = true
local wantCrystal    = true
local onPickStatus   = nil

-- Handler pickup untuk satu item
local function handleItem(item)
    if not pickupActive then return end
    if not item:IsA("Tool") then return end
    if isInInventory(item) then return end

    local ok = (wantRune and isRune(item)) or (wantCrystal and isCrystal(item))
    if not ok then return end

    -- Cek radius jika diperlukan (radius 0 = ambil dari mana saja)
    if pickupRadius > 0 then
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local handle = item:FindFirstChildOfClass("BasePart")
                or item:FindFirstChildOfClass("MeshPart")
                or item:FindFirstChildOfClass("Part")
            if handle then
                local dist = (handle.Position - hrp.Position).Magnitude
                if dist > pickupRadius then return end
            end
        end
    end

    local success = pickupItem(item)
    if success then
        pickupTotal = pickupTotal + 1
        if onPickStatus then
            onPickStatus(string.format(
                "🧲 Pickup! %s | total: %d", item.Name, pickupTotal
            ))
        end
    end
end

-- Sweep semua item di workspace (backup / saat baru start)
local function sweepWorkspace()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local function scanNode(node, depth)
        if depth > 8 then return end
        local ok, children = pcall(node.GetChildren, node)
        if not ok then return end
        for _, obj in ipairs(children) do
            if not pickupActive then return end
            if obj:IsA("Tool") and not isInInventory(obj) then
                task.spawn(handleItem, obj)
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scanNode(obj, depth + 1)
            end
        end
    end
    scanNode(workspace, 0)
end

local function startPickup(wR, wC, radius, onStatus)
    if pickupActive then return end
    pickupActive  = true
    pickupTotal   = 0
    wantRune      = wR
    wantCrystal   = wC
    pickupRadius  = radius
    onPickStatus  = onStatus

    -- ── Jalur 1: DescendantAdded (REAKTIF — langsung saat item muncul) ──
    pickupConn = workspace.DescendantAdded:Connect(function(obj)
        task.spawn(handleItem, obj)
    end)

    -- ── Jalur 2: Backup sweeper setiap 0.5 detik ──
    pickupSweep = task.spawn(function()
        while pickupActive do
            sweepWorkspace()
            if onPickStatus then
                onPickStatus(string.format(
                    "🟢 Aktif | radius %.0f studs | total: %d",
                    pickupRadius, pickupTotal
                ))
            end
            task.wait(0.5)
        end
    end)

    -- Sweep pertama langsung
    task.spawn(sweepWorkspace)

    if onStatus then onStatus("✅ Instant Pickup aktif!") end
end

local function stopPickup()
    pickupActive = false
    if pickupConn then
        pcall(function() pickupConn:Disconnect() end)
        pickupConn = nil
    end
    if pickupSweep then
        pcall(function() task.cancel(pickupSweep) end)
        pickupSweep = nil
    end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 1 : Die-to-Drop
-- ════════════════════════════════════════════════════════════════
local function dieCharacter(onStatus)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        if onStatus then onStatus("❌ Humanoid tidak ditemukan!") end
        return
    end
    if onStatus then onStatus("💀 Mematikan karakter...") end

    pcall(function() hum.Health = 0 end)
    if hum.Health > 0 then
        pcall(function() hum:TakeDamage(math.huge) end)
    end
    if hum.Health > 0 then
        pcall(function()
            for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if v:IsA("RemoteEvent") and v.Name:lower():find("kill") then
                    v:FireServer(); break
                end
            end
        end)
    end

    task.wait(0.6)
    if onStatus then onStatus("✅ Karakter mati! Item di-drop ke lantai.") end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 2 : Rune Dropper
-- ════════════════════════════════════════════════════════════════
local runeDropping = false

local function dropRunes(nameFilter, delayMs, onStatus)
    if runeDropping then return end
    runeDropping = true

    local runes = getInventory(function(t)
        if not isRune(t) then return false end
        if nameFilter and nameFilter ~= "" and nameFilter:lower() ~= "all" then
            return t.Name:lower():find(nameFilter:lower(), 1, true) ~= nil
        end
        return true
    end)

    if #runes == 0 then
        if onStatus then onStatus("⚠️ Tidak ada rune yang cocok!") end
        runeDropping = false; return
    end

    local holdMs = math.max(math.floor(delayMs * 0.4), 1)
    local waitMs = math.max(delayMs - holdMs, 1)
    local count  = 0

    for i, tool in ipairs(runes) do
        if not runeDropping then break end
        if tool and tool.Parent then
            if onStatus then
                onStatus(string.format("🔮 %d/%d → %s", i, #runes, tool.Name))
            end
            if equipTool(tool) then
                task.wait(waitMs / 1000)
                pressKey(Enum.KeyCode.Escape, holdMs)
                task.wait(waitMs / 1000)
                count = count + 1
            end
        end
    end

    runeDropping = false
    if onStatus then onStatus(string.format("✅ %d rune di-drop.", count)) end
end

