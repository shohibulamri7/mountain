-- Status executor
local ftiOk = hasFTI and "✅" or "❌"
local fcdOk = hasFCD and "✅" or "❌"
local frpOk = hasFRP and "✅" or "❌"
mkLbl(ftiOk.." firetouchinterest (pickup+mine server-side)",1,hasFTI and GREEN or RED)
mkLbl(fcdOk.." fireclickdetector (mine ClickDetector)",     2,hasFCD and GREEN or ORANGE)
mkLbl(frpOk.." fireproximityprompt (mine Proximity)",       3,hasFRP and GREEN or ORANGE)
mkLbl("⚠️  Tanpa FTI, pickup pakai teleport HRP (server replicate)",4,ORANGE)
