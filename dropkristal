-- ─── Render list kristal ─────────────────────────────────
local function refreshList()
    -- Hapus item lama
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local kristals = getKristals()

    if #kristals == 0 then
        statusLbl.Text = "Tidak ada kristal di tas."
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        return
    end

    statusLbl.Text = #kristals .. " kristal ditemukan"

    for i, kr in ipairs(kristals) do
        local itemBtn = Instance.new("TextButton")
        itemBtn.Size             = UDim2.new(1, -6, 0, 30)
        itemBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        itemBtn.Text             = "  💎 " .. kr.Name
        itemBtn.TextColor3       = Color3.new(1, 1, 1)
        itemBtn.TextSize         = 13
        itemBtn.Font             = Enum.Font.Gotham
        itemBtn.TextXAlignment   = Enum.TextXAlignment.Left
        itemBtn.AutoButtonColor  = true
        itemBtn.BorderSizePixel  = 0
        itemBtn.LayoutOrder      = i
        itemBtn.Parent           = scrollFrame

        local ic = Instance.new("UICorner")
        ic.CornerRadius = UDim.new(0, 5)
        ic.Parent = itemBtn

        itemBtn.MouseButton1Click:Connect(function()
            itemBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
            itemBtn.Text = "  ✅ Dropping..."

            local ok = dropSatu(kr)

            if ok then
                statusLbl.Text = kr.Name .. " di-drop!"
            else
                statusLbl.Text = "Gagal drop " .. kr.Name
            end

            task.wait(0.3)
            itemBtn:Destroy()

            -- Update canvas & count
            local sisa = getKristals()
            statusLbl.Text = #sisa .. " kristal tersisa"
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #sisa * 33)
        end)
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #kristals * 33)
end

-- ── Event tombol ─────────────────────────────────────────
refreshBtn.MouseButton1Click:Connect(refreshList)

dropAllBtn.MouseButton1Click:Connect(function()
    local kristals = getKristals()
    if #kristals == 0 then
        statusLbl.Text = "Tidak ada kristal!"
        return
    end

    dropAllBtn.Text = "⏳ Dropping..."

    for i, kr in ipairs(kristals) do
        statusLbl.Text = "Drop " .. i .. "/" .. #kristals .. " - " .. kr.Name
        dropSatu(kr)
        task.wait(0.2)
    end

    dropAllBtn.Text = "💥 Drop Semua"
    statusLbl.Text  = "Selesai!"
    refreshList()
end)

