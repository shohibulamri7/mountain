--  CRYSTAL TOOLS v5  –  SERVER-SIDE (keliatan semua player!)
--  Pickup & Mine pakai firetouchinterest + teleport HRP
--  Bukan client-only reparent — item benar-benar terangkat di server
-- ═══════════════════════════════════════════════════════════════════

local Players    = game:GetService("Players")
local UIS        = game:GetService("UserInputService")
local LP         = Players.LocalPlayer

-- VirtualInputManager
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

-- Executor functions
local hasFTI = type(firetouchinterest)   == "function"
local hasFCD = type(fireclickdetector)   == "function"
local hasFRP = type(fireproximityprompt) == "function"

-- ── Attr helper ──────────────────────────────────────────────────
local function attr(inst, name)
    if not inst then return nil end
    local ok, v = pcall(inst.GetAttribute, inst, name)
    return ok and v or nil
end

local function isRune(t)
    if not t or not t:IsA("Tool") then return false end
    if attr(t,"RuneType") ~= nil then return true end
    if attr(t,"Rune")     ~= nil then return true end
    return t.Name:lower():find("rune") ~= nil
end

local function isCrystal(t)
    if not t or not t:IsA("Tool") then return false end
    return attr(t,"Tier") ~= nil
end

local function isInInventory(tool)
    local p = tool.Parent
    if not p then return true end
    if p:IsA("Backpack") then return true end
    if Players:GetPlayerFromCharacter(p) then return true end
    return false
end

local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ── Simulasi key press ───────────────────────────────────────────
local function pressKey(keyCode, holdMs)
    holdMs = math.max(holdMs or 10, 1)
    if VIM then
        pcall(function()
            VIM:SendKeyEvent(true,  keyCode, false, game)
            task.wait(holdMs/1000)
            VIM:SendKeyEvent(false, keyCode, false, game)
        end)
    else
        pcall(function()
            local i = Instance.new("InputObject")
            i.KeyCode        = keyCode
            i.UserInputType  = Enum.UserInputType.Keyboard
            i.UserInputState = Enum.UserInputState.Begin
            UIS.InputBegan:Fire(i, false)
            task.wait(holdMs/1000)
            i.UserInputState = Enum.UserInputState.End
            UIS.InputEnded:Fire(i, false)
        end)
    end
end

local function equipTool(tool)
    local hum = getHum()
    if not hum then return false end
    return pcall(hum.EquipTool, hum, tool)
end

local function getInventory(filterFn)
    local list = {}
    local function scan(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (not filterFn or filterFn(t)) then
                list[#list+1] = t
            end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"))
    if LP.Character then scan(LP.Character) end
    return list
end

-- ════════════════════════════════════════════════════════════════
--  SERVER-SIDE PICKUP CORE
--  Urutan: firetouchinterest → teleport HRP ke item → item ke HRP
--  TIDAK pakai reparent (client-only, tidak keliatan teman)
-- ════════════════════════════════════════════════════════════════
local function serverPickup(tool)
    if not tool or not tool.Parent then return false end
    if isInInventory(tool) then return false end

    local hrp = getHRP()
    if not hrp then return false end

    -- Cari handle tool
    local handle = tool:FindFirstChild("Handle")
        or tool:FindFirstChildOfClass("BasePart")
        or tool:FindFirstChildOfClass("MeshPart")
        or tool:FindFirstChildOfClass("Part")
    if not handle then return false end

    -- ══ METODE 1: firetouchinterest ══
    -- Ini server-side! Server menerima event Touch → pickup terjadi sungguhan
    if hasFTI then
        pcall(function()
            firetouchinterest(handle, hrp, 0)  -- Touch Begin (server)
        end)
        task.wait(0.05)
        pcall(function()
            firetouchinterest(handle, hrp, 1)  -- Touch End (server)
        end)
        task.wait(0.05)
        if isInInventory(tool) then return true end
    end

    -- ══ METODE 2: Teleport HRP ke posisi item ══
    -- Server melihat pergerakan karakter → trigger Touch server-side
    pcall(function()
        local savedCF = hrp.CFrame
        hrp.CFrame = handle.CFrame * CFrame.new(0, 1, 0)
        task.wait(0.08)
        -- cek apakah sudah kena
        if not isInInventory(tool) then
            hrp.CFrame = savedCF
        end
    end)
    task.wait(0.05)
    if isInInventory(tool) then return true end

    -- ══ METODE 3: Gerakkan item ke HRP (item datang ke kita) ══
    pcall(function()
        for _ = 1, 5 do
            if isInInventory(tool) then break end
            handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -1)
            task.wait(0.04)
        end
    end)
    task.wait(0.05)
    if isInInventory(tool) then return true end

    -- ══ METODE 4: FireServer RemoteEvent pickup ══
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        for _, v in ipairs(rs:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                local n = v.Name:lower()
                if n:find("pickup") or n:find("collect") or n:find("grab") or n:find("loot") then
                    if v:IsA("RemoteEvent") then
                        v:FireServer(tool)
                    else
                        pcall(v.InvokeServer, v, tool)
                    end
                    task.wait(0.05)
                    if isInInventory(tool) then return end
                end
            end
        end
    end)

    return isInInventory(tool)
end

-- ════════════════════════════════════════════════════════════════
--  INSTANT PICKUP SYSTEM
--  DescendantAdded (reaktif, 0ms delay) + backup sweeper 0.3 dtk
-- ════════════════════════════════════════════════════════════════
local pickActive   = false
local pickTotal    = 0
local pickConn     = nil
local pickSweep    = nil
local pickRadius   = 0
local pickRune     = true
local pickCrystal  = true
local pickTeleport = false   -- teleport karakter ke item (lebih pasti server-side)
local onPickSt     = nil

local function handlePickItem(item)
    if not pickActive then return end
    if not item:IsA("Tool") then return end
    if isInInventory(item) then return end

    local want = (pickRune and isRune(item)) or (pickCrystal and isCrystal(item))
    if not want then return end

    -- Cek radius
    if pickRadius > 0 then
        local hrp = getHRP()
        local handle = item:FindFirstChildOfClass("BasePart")
            or item:FindFirstChildOfClass("MeshPart")
            or item:FindFirstChildOfClass("Part")
        if hrp and handle then
            if (handle.Position - hrp.Position).Magnitude > pickRadius then return end
        end
    end

    -- Opsi teleport karakter ke item dulu (100% server-side)
    if pickTeleport then
        local hrp = getHRP()
        local handle = item:FindFirstChildOfClass("BasePart")
            or item:FindFirstChildOfClass("MeshPart")
            or item:FindFirstChildOfClass("Part")
        if hrp and handle then
            pcall(function()
                hrp.CFrame = handle.CFrame * CFrame.new(0, 2, 0)
            end)
            task.wait(0.05)
        end
    end

    local ok = serverPickup(item)
    if ok then
        pickTotal = pickTotal + 1
        if onPickSt then
            onPickSt(string.format("✅ [%s] | total: %d", item.Name, pickTotal))
        end
    end
end

local function sweepAll()
    local function scan(node, depth)
        if depth > 8 then return end
        local ok, ch = pcall(node.GetChildren, node)
        if not ok then return end
        for _, obj in ipairs(ch) do
            if not pickActive then return end
            if obj:IsA("Tool") and not isInInventory(obj) then
                task.spawn(handlePickItem, obj)
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scan(obj, depth+1)
            end
        end
    end
    scan(workspace, 0)
end

local function startPickup(wR, wC, radius, teleport, onStatus)
    if pickActive then return end
    pickActive    = true
    pickTotal     = 0
    pickRune      = wR
    pickCrystal   = wC
    pickRadius    = radius
    pickTeleport  = teleport
    onPickSt      = onStatus

    -- REAKTIF: langsung saat item muncul di workspace
    pickConn = workspace.DescendantAdded:Connect(function(obj)
        task.spawn(handlePickItem, obj)
    end)

    -- BACKUP SWEEPER setiap 0.3 detik
    pickSweep = task.spawn(function()
        while pickActive do
            sweepAll()
            if onStatus then
                onStatus(string.format(
                    "🧲 Aktif | radius:%.0f | total:%d | tele:%s",
                    pickRadius, pickTotal, teleport and "ON" or "OFF"
                ))
            end
            task.wait(0.3)
        end
        if onStatus then onStatus("■ Pickup stop. Total: "..pickTotal) end
    end)

    task.spawn(sweepAll)
    if onStatus then onStatus("🟢 Instant Pickup SERVER-SIDE aktif!") end
end

local function stopPickup()
    pickActive = false
    if pickConn  then pcall(function() pickConn:Disconnect() end); pickConn = nil end
    if pickSweep then pcall(task.cancel, pickSweep);               pickSweep = nil end
end

-- ════════════════════════════════════════════════════════════════
--  INSTANT MINE (server-side)
--  fireclickdetector + firetouchinterest + teleport HRP ke node
-- ════════════════════════════════════════════════════════════════
local mineActive  = false
local mineTotal   = 0
local mineThread  = nil
local swingThread = nil
local onMineSt    = nil

-- Cari node tambang di workspace
local function findNodes(radius, kws)
    local hrp = getHRP()
    if not hrp then return {} end
    local pos  = hrp.Position
    local list = {}

    local function matchName(n)
        n = n:lower()
        for _, k in ipairs(kws) do
            if n:find(k:lower(), 1, true) then return true end
        end
        return false
    end

    local function scan(parent, depth)
        if depth > 6 then return end
        local ok, ch = pcall(parent.GetChildren, parent)
        if not ok then return end
        for _, obj in ipairs(ch) do
            if not obj:IsA("Tool") then -- bukan item pickup
                local isNode = matchName(obj.Name)
                    or obj:FindFirstChildOfClass("ClickDetector")   ~= nil
                    or obj:FindFirstChildOfClass("ProximityPrompt") ~= nil
                    or attr(obj,"CrystalType") ~= nil
                    or attr(obj,"NodeType")    ~= nil

                if isNode then
                    local part = (obj:IsA("BasePart") and obj)
                        or obj:FindFirstChildOfClass("BasePart")
                        or obj:FindFirstChildOfClass("MeshPart")
                        or obj:FindFirstChildOfClass("Part")
                    if part then
                        local dist = (part.Position - pos).Magnitude
                        if radius == 0 or dist <= radius then
                            list[#list+1] = {obj=obj, part=part, dist=dist}
                        end
                    end
                end

                if obj:IsA("Folder") or obj:IsA("Model") then
                    scan(obj, depth+1)
                end
            end
        end
    end
    scan(workspace, 0)
    table.sort(list, function(a,b) return a.dist < b.dist end)
    return list
end

-- Tambang satu node (server-side)
local function mineOne(info)
    local obj  = info.obj
    local part = info.part
    local hrp  = getHRP()
    if not hrp then return false end

    -- Metode 1: fireclickdetector (SERVER-SIDE)
    if hasFCD then
        local cd = obj:FindFirstChildOfClass("ClickDetector", true)
        if cd then
            pcall(function() fireclickdetector(cd, 0) end)
            return true
        end
    end

    -- Metode 2: fireproximityprompt (SERVER-SIDE)
    if hasFRP then
        local pp = obj:FindFirstChildOfClass("ProximityPrompt", true)
        if pp then
            pcall(function() fireproximityprompt(pp) end)
            return true
        end
    end

    -- Metode 3: firetouchinterest (SERVER-SIDE)
    if hasFTI then
        pcall(function()
            firetouchinterest(part, hrp, 0)
            task.wait(0.02)
            firetouchinterest(part, hrp, 1)
        end)
        return true
    end

    -- Metode 4: Teleport HRP ke node (server melihat pergerakan)
    pcall(function()
        hrp.CFrame = part.CFrame * CFrame.new(0, 2, 0)
    end)
    return true
end

-- Auto-swing tool yang di-equip
local function startSwing(ms)
    if swingThread then pcall(task.cancel, swingThread) end
    swingThread = task.spawn(function()
        while mineActive do
            pcall(function()
                local c = LP.Character
                if not c then return end
                for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then
                        -- Activate (server-side via RemoteEvent internal tool)
                        pcall(t.Activate, t)
                        -- VIM mouse click
                        if VIM then
                            pcall(function()
                                VIM:SendMouseButtonEvent(0,0,0,true, game,1)
                                task.wait(0.01)
                                VIM:SendMouseButtonEvent(0,0,0,false,game,1)
                            end)
                        end
                    end
                end
            end)
            task.wait(math.max(ms, 1)/1000)
        end
    end)
end

local function startMine(radius, swingMs, kws, onStatus)
    if mineActive then return end
    mineActive = true
    mineTotal  = 0
    onMineSt   = onStatus

    startSwing(swingMs)

    mineThread = task.spawn(function()
        while mineActive do
            local nodes = findNodes(radius, kws)
            if #nodes > 0 then
                for _, nd in ipairs(nodes) do
                    if not mineActive then break end
                    mineOne(nd)
                    mineTotal = mineTotal + 1
                    task.wait(math.max(swingMs, 1)/1000)
                end
                if onStatus then
                    onStatus(string.format("⛏️ %d node | hits:%d", #nodes, mineTotal))
                end
            else
                if onStatus then onStatus("⛏️ Mencari node...") end
                task.wait(0.5)
            end
        end
        if onStatus then onStatus("■ Mine stop. Total hits: "..mineTotal) end
    end)
end

local function stopMine()
    mineActive = false
    if mineThread  then pcall(task.cancel, mineThread);  mineThread  = nil end
    if swingThread then pcall(task.cancel, swingThread); swingThread = nil end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 3: Die-to-Drop
-- ════════════════════════════════════════════════════════════════
local function dieChar(onStatus)
    local hum = getHum()
    if not hum then if onStatus then onStatus("❌ Tidak ada Humanoid!") end; return end
    if onStatus then onStatus("💀 Mematikan karakter...") end
    pcall(function() hum.Health = 0 end)
    if hum.Health > 0 then pcall(function() hum:TakeDamage(math.huge) end) end
    if hum.Health > 0 then
        pcall(function()
            for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if v:IsA("RemoteEvent") and v.Name:lower():find("kill") then
                    v:FireServer(); break
                end
            end
        end)
    end
    task.wait(0.5)
    if onStatus then onStatus("✅ Mati! Semua item di-drop.") end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 4: Rune Dropper
-- ════════════════════════════════════════════════════════════════
local runeDropping = false

local function dropRunes(filter, delayMs, onStatus)
    if runeDropping then return end
    runeDropping = true
    local runes = getInventory(function(t)
        if not isRune(t) then return false end
        if filter and filter ~= "" and filter:lower() ~= "all" then
            return t.Name:lower():find(filter:lower(), 1, true) ~= nil
        end
        return true
    end)
    if #runes == 0 then
        if onStatus then onStatus("⚠️ Tidak ada rune!") end
        runeDropping = false; return
    end
    local holdMs = math.max(math.floor(delayMs*0.4), 1)
    local waitMs = math.max(delayMs - holdMs, 1)
    local count  = 0
    for i, t in ipairs(runes) do
        if not runeDropping then break end
        if t and t.Parent then
            if onStatus then onStatus(string.format("🔮 %d/%d → %s", i, #runes, t.Name)) end
            if equipTool(t) then
                task.wait(waitMs/1000)
                pressKey(Enum.KeyCode.Escape, holdMs)
                task.wait(waitMs/1000)
                count = count + 1
            end
        end
    end
    runeDropping = false
    if onStatus then onStatus(string.format("✅ %d rune di-drop.", count)) end
end

