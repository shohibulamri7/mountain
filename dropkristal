    wrap.BackgroundTransparency=1; wrap.Parent=Scroll
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0,44,0,22); btn.AnchorPoint=Vector2.new(1,0.5)
    btn.Position=UDim2.new(1,0,0.5,0); btn.BorderSizePixel=0
    btn.Font=Enum.Font.GothamBold; btn.TextSize=10; btn.Parent=wrap
    Instance.new("UICorner",btn).CornerRadius=UDim.new(1,0)
    local ll=Instance.new("TextLabel")
    ll.Size=UDim2.new(1,-52,1,0); ll.BackgroundTransparency=1
    ll.Text=text; ll.TextColor3=TEXT; ll.Font=Enum.Font.Gotham
    ll.TextSize=11; ll.TextXAlignment=Enum.TextXAlignment.Left; ll.Parent=wrap
    local state=default
    local function refresh()
        btn.BackgroundColor3=state and GREEN or Color3.fromRGB(65,65,80)
        btn.Text=state and "ON" or "OFF"; btn.TextColor3=Color3.new(1,1,1)
    end
    refresh()
    btn.MouseButton1Click:Connect(function() state=not state; refresh() end)
    return function() return state end
end

local function mkBtn(text, color, order, fn)
    local btn=Instance.new("TextButton")
    btn.LayoutOrder=order; btn.Size=UDim2.new(1,0,0,32)
    btn.BackgroundColor3=color; btn.Text=text; btn.TextColor3=Color3.new(1,1,1)
    btn.Font=Enum.Font.GothamBold; btn.TextSize=12; btn.BorderSizePixel=0; btn.Parent=Scroll
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,7)
    btn.MouseButton1Click:Connect(fn); return btn
end

local function mkSep(order)
    local s=Instance.new("Frame")
    s.LayoutOrder=order; s.Size=UDim2.new(1,0,0,1)
    s.BackgroundColor3=SEP; s.BorderSizePixel=0; s.Parent=Scroll
end

