-- ── SECTION 1: INSTANT MINE ──────────────────────────────────────
mkSec("⛏️  FITUR 1 — INSTANT MINE (server-side)",10,Color3.fromRGB(160,100,0))
mkLbl("fireclickdetector + firetouchinterest + teleport ke node.",11)

local mine_r  = mkInput("Radius (0=semua map):", "0",  12)
local mine_ms = mkInput("Interval swing (ms):",  "50", 13)
local mine_kw = mkInput("Keyword node:",  "crystal,gem,rune,ore,node,rock", 14)
mkLbl("  Pisah koma. Sesuaikan nama Part di game.",15)

local mine_st = mkSt(16)
local mineBtn = mkBtn("⛏️  MULAI INSTANT MINE",YELLOW,17,function() end)
mkBtn("■  STOP Mine",Color3.fromRGB(70,70,90),18,function()
    stopMine(); mineBtn.BackgroundColor3=YELLOW; mine_st.Text="■ Mine stop."
end)
mineBtn.MouseButton1Click:Connect(function()
    if mineActive then mine_st.Text="⏳ Sudah aktif!"; return end
    local r=tonumber(mine_r.Text) or 0
    local ms=math.max(tonumber(mine_ms.Text) or 50, 1)
    local kws={}
    for k in (mine_kw.Text or "crystal"):gmatch("[^,]+") do
        kws[#kws+1]=k:match("^%s*(.-)%s*$")
    end
    startMine(r, ms, kws, function(s) mine_st.Text=s end)
    mineBtn.BackgroundColor3=Color3.fromRGB(140,90,0)
end)
mkSep(19)

-- ── SECTION 2: INSTANT PICKUP ────────────────────────────────────
mkSec("🧲  FITUR 2 — INSTANT PICKUP (server-side, keliatan teman)",30,GREEN)
mkLbl("Pakai firetouchinterest → item BENAR-BENAR terangkat di server.",31)
mkLbl("Aktifkan 'Teleport ke Item' agar server 100% melihat pickup.",32)

local pick_r    = mkInput("Radius (0=semua map):", "0", 33)
local getPickR  = mkToggle("Pickup Rune",            true, 34)
local getPickC  = mkToggle("Pickup Kristal",         true, 35)
local getPickTp = mkToggle("Teleport ke Item (server-safe)", true, 36)
mkLbl("  Teleport ON = karakter bergerak ke setiap item (lebih pasti).",37)

local pick_st  = mkSt(38)
local pickBtn  = mkBtn("▶  MULAI INSTANT PICKUP",GREEN,39,function() end)
mkBtn("■  STOP Pickup",Color3.fromRGB(70,70,90),40,function()
    stopPickup(); pickBtn.BackgroundColor3=GREEN; pick_st.Text="■ Pickup stop."
end)
pickBtn.MouseButton1Click:Connect(function()
    if pickActive then pick_st.Text="⏳ Sudah aktif!"; return end
    local r=tonumber(pick_r.Text) or 0
    local wR=getPickR(); local wC=getPickC(); local tp=getPickTp()
    if not wR and not wC then pick_st.Text="⚠️ Aktifkan Rune/Kristal!"; return end
    startPickup(wR, wC, r, tp, function(s) pick_st.Text=s end)
    pickBtn.BackgroundColor3=Color3.fromRGB(0,130,50)
end)
mkSep(41)

