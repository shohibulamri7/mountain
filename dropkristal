--[[
    DropSemua.lua
    Tombol 1 klik → keluarkan semua isi tas serentak
    Anti-underground (raycast lantai), scatter acak, tidak tumpuk
]]

local Players  = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui  = game:GetService("CoreGui")

local lp       = Players.LocalPlayer

-- ══════════════════════════════
--  FUNGSI UTAMA
-- ══════════════════════════════

local function groundY(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = lp.Character
    if char then params.FilterDescendantsInstances = {char} end
    local hit = Workspace:Raycast(pos + Vector3.new(0, 10, 0), Vector3.new(0, -60, 0), params)
    return hit and hit.Position.Y or (pos.Y - 3)
end

local function dropAll()
    local char     = lp.Character
    local backpack = lp:FindFirstChildOfClass("Backpack")
    local hrp      = char and char:FindFirstChild("HumanoidRootPart")
    local origin   = hrp and hrp.Position or Vector3.new(0, 5, 0)

    -- Unequip dulu
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end

    -- Kumpulkan semua Tool dari karakter + backpack
    local tools = {}
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then tools[#tools+1] = v end
        end
    end
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then tools[#tools+1] = v end
        end
    end

    if #tools == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Drop", Text = "Tas kosong!", Duration = 2
        })
        return
    end

    -- Lempar semua serentak
    for _, tool in ipairs(tools) do
        task.spawn(function()
            -- Posisi scatter acak di sekitar pemain
            local angle = math.random() * 2 * math.pi
            local r     = 1.5 + math.random() * 2.5   -- 1.5–4 studs
            local sx    = origin.X + math.cos(angle) * r
            local sz    = origin.Z + math.sin(angle) * r

            -- Cari lantai di titik itu
            local floor = groundY(Vector3.new(sx, origin.Y, sz))
            local spawnPos = Vector3.new(sx, floor + 1.5, sz)

            -- Pindahkan ke Workspace
            tool.Parent = Workspace

            -- Cari BasePart (Handle atau part pertama)
            local part = tool:FindFirstChild("Handle")
                      or tool.PrimaryPart
                      or tool:FindFirstChildWhichIsA("BasePart")

            if part then
                part.Anchored = false
                part.CFrame   = CFrame.new(spawnPos)
                -- Beri sedikit velocity agar tidak diam
                local va = math.random() * 2 * math.pi
                part.AssemblyLinearVelocity = Vector3.new(
                    math.cos(va) * 5,
                    4,
                    math.sin(va) * 5
                )
            end
        end)
    end

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Drop", Text = #tools .. " item dikeluarkan!", Duration = 2
    })
end

-- ══════════════════════════════
--  BUAT TOMBOL GUI
-- ══════════════════════════════

-- Hapus GUI lama jika ada
