btn.Position         = UDim2.new(0, 5, 0, 5)
btn.BackgroundColor3 = Color3.fromRGB(210, 35, 35)
btn.BorderSizePixel  = 0
btn.Text             = "🎒  DROP SEMUA"
btn.TextColor3       = Color3.new(1, 1, 1)
btn.TextSize         = 17
btn.Font             = Enum.Font.GothamBold
btn.AutoButtonColor  = false
btn.Parent           = frame

