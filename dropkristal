local Players    = game:GetService("Players")
local UIS        = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LP         = Players.LocalPlayer

-- VirtualInputManager
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

-- Cek executor functions
local hasFTI  = type(firetouchinterest)  == "function"
local hasFCD  = type(fireclickdetector)  == "function"
local hasFRP  = type(fireproximityprompt)== "function"

-- ── Attr helper ──────────────────────────────────────────────────
local function attr(inst, name)
    if not inst then return nil end
    local ok, v = pcall(inst.GetAttribute, inst, name)
    return ok and v or nil
end

local function isRune(t)
    if not t or not t:IsA("Tool") then return false end
    if attr(t,"RuneType") ~= nil then return true end
    if attr(t,"Rune")     ~= nil then return true end
    if t.Name:lower():find("rune") then return true end
    return false
end

local function isCrystal(t)
    if not t or not t:IsA("Tool") then return false end
    return attr(t,"Tier") ~= nil
end

local function isInInventory(tool)
    local p = tool.Parent
    if not p then return true end
    if p:IsA("Backpack") then return true end
    if Players:GetPlayerFromCharacter(p) then return true end
    return false
end

-- ── Simulasi key press ───────────────────────────────────────────
local function pressKey(keyCode, holdMs)
    holdMs = math.max(holdMs or 10, 1)
    if VIM then
        pcall(function()
            VIM:SendKeyEvent(true,  keyCode, false, game)
            task.wait(holdMs/1000)
            VIM:SendKeyEvent(false, keyCode, false, game)
        end)
    else
        pcall(function()
            local inp = Instance.new("InputObject")
            inp.KeyCode        = keyCode
            inp.UserInputType  = Enum.UserInputType.Keyboard
            inp.UserInputState = Enum.UserInputState.Begin
            UIS.InputBegan:Fire(inp, false)
            task.wait(holdMs/1000)
            inp.UserInputState = Enum.UserInputState.End
            UIS.InputEnded:Fire(inp, false)
        end)
    end
end

-- ── Equip tool ───────────────────────────────────────────────────
local function equipTool(tool)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return pcall(hum.EquipTool, hum, tool)
end

-- ── Scan inventory ───────────────────────────────────────────────
local function getInventory(filterFn)
    local list = {}
    local function scan(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (not filterFn or filterFn(t)) then
                list[#list+1] = t
            end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"))
    if LP.Character then scan(LP.Character) end
    return list
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 1: INSTANT MINE
--  Scan workspace → cari node kristal (part/model dengan
--  ClickDetector, ProximityPrompt, atau bisa di-touch)
--  Lalu trigger tambang secepat mungkin
-- ════════════════════════════════════════════════════════════════
local mineActive  = false
local mineTotal   = 0
local mineThread  = nil
local onMineStatus= nil

-- Kumpulkan semua "node tambang" di workspace dalam radius
local function findMineNodes(radius, keywords)
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local pos  = hrp.Position
    local nodes= {}

    -- keyword default untuk mengenali node kristal/rune
    local kw = keywords or {"crystal","gem","rune","ore","rock","node","mine","spawn"}

    local function matchName(name)
        name = name:lower()
        for _, k in ipairs(kw) do
            if name:find(k, 1, true) then return true end
        end
        return false
    end

    local function scanNode(parent, depth)
        if depth > 6 then return end
        local ok, ch = pcall(parent.GetChildren, parent)
        if not ok then return end
        for _, obj in ipairs(ch) do
            local isTarget = false

            -- Cek nama
            if matchName(obj.Name) then isTarget = true end

            -- Cek punya ClickDetector / ProximityPrompt
            if not isTarget then
                if obj:FindFirstChildOfClass("ClickDetector")   then isTarget = true end
                if obj:FindFirstChildOfClass("ProximityPrompt") then isTarget = true end
            end

            -- Cek attribute tambang
            if not isTarget then
                if attr(obj,"Crystal")  ~= nil then isTarget = true end
                if attr(obj,"CrystalType") ~= nil then isTarget = true end
                if attr(obj,"NodeType") ~= nil then isTarget = true end
                if attr(obj,"Health")   ~= nil and not obj:IsA("Tool") then isTarget = true end
            end

            if isTarget and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Part")) then
                local part = obj:IsA("BasePart") and obj
                    or obj:FindFirstChildOfClass("BasePart")
                    or obj:FindFirstChildOfClass("MeshPart")
                    or obj:FindFirstChildOfClass("Part")
                if part then
                    local dist = (part.Position - pos).Magnitude
                    if radius == 0 or dist <= radius then
                        nodes[#nodes+1] = {obj=obj, part=part, dist=dist}
                    end
                end
            end

            -- Rekursif
            if obj:IsA("Folder") or obj:IsA("Model") then
                scanNode(obj, depth+1)
            end
        end
    end

    scanNode(workspace, 0)
    table.sort(nodes, function(a,b) return a.dist < b.dist end)
    return nodes
end

-- Tambang satu node dengan semua metode
local function mineNode(nodeInfo)
    local obj  = nodeInfo.obj
    local part = nodeInfo.part
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Metode 1: fireclickdetector
    if hasFCD then
        local cd = obj:FindFirstChildOfClass("ClickDetector")
            or (obj.Parent and obj.Parent:FindFirstChildOfClass("ClickDetector"))
        if cd then
            pcall(function() fireclickdetector(cd, 0) end)
            return true
        end
    end

    -- Metode 2: fireproximityprompt
    if hasFRP then
        local pp = obj:FindFirstChildOfClass("ProximityPrompt",true)
        if pp then
            pcall(function() fireproximityprompt(pp) end)
            return true
        end
    end

    -- Metode 3: firetouchinterest (sentuh node)
    if hasFTI then
        pcall(function()
            firetouchinterest(part, hrp, 0)
            task.wait(0.02)
            firetouchinterest(part, hrp, 1)
        end)
        return true
    end

    -- Metode 4: Teleport HRP ke node (trigger touch server-side)
    pcall(function()
        local savedCF = hrp.CFrame
        hrp.CFrame = part.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.05)
        hrp.CFrame = savedCF
    end)

    -- Metode 5: Activate tool yang sedang di-equip (ayun pickaxe)
    pcall(function()
        local char2 = LP.Character
        if not char2 then return end
        for _, t in ipairs(char2:GetChildren()) do
            if t:IsA("Tool") then
                t:Activate()
            end
        end
    end)

    -- Metode 6: Simulasi mouse click kiri via VIM
    if VIM then
        pcall(function()
            VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
    end

    return true
end

-- Simulasi swing cepat tool yang di-equip (loop terpisah)
local swingActive = false
local swingThread = nil

local function startSwing(intervalMs)
    if swingActive then return end
    swingActive = true
    swingThread = task.spawn(function()
        while swingActive do
            -- Activate semua tool di karakter
            pcall(function()
                local char = LP.Character
                if not char then return end
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") then
                        pcall(t.Activate, t)
                    end
                end
            end)
            -- Simulasi klik kiri
            if VIM then
                pcall(function()
                    VIM:SendMouseButtonEvent(0,0,0,true, game,1)
                    task.wait(0.01)
                    VIM:SendMouseButtonEvent(0,0,0,false,game,1)
                end)
            end
            task.wait(math.max(intervalMs, 1) / 1000)
        end
    end)
end

local function stopSwing()
    swingActive = false
    if swingThread then
        pcall(task.cancel, swingThread)
        swingThread = nil
    end
end

-- Loop utama instant mine
local function startMine(radius, intervalMs, keywords, onStatus)
    if mineActive then return end
    mineActive = true
    mineTotal  = 0
    onMineStatus = onStatus

    -- Mulai swing tool juga
    startSwing(intervalMs)

    mineThread = task.spawn(function()
        while mineActive do
            local nodes = findMineNodes(radius, keywords)
            if #nodes == 0 then
                if onStatus then onStatus("⛏️ Aktif | tidak ada node di radius ini...") end
            else
                for _, nodeInfo in ipairs(nodes) do
                    if not mineActive then break end
                    local ok = mineNode(nodeInfo)
                    if ok then
                        mineTotal = mineTotal + 1
                    end
                    task.wait(math.max(intervalMs, 1) / 1000)
                end
                if onStatus then
                    onStatus(string.format(
                        "⛏️ Mining! %d node | radius %.0f | hits: %d",
                        #nodes, radius, mineTotal
                    ))
                end
            end
            task.wait(math.max(intervalMs, 50) / 1000)
        end
        if onStatus then onStatus("■ Mine dihentikan. Total hits: "..mineTotal) end
    end)
end

local function stopMine()
    mineActive = false
    stopSwing()
    if mineThread then
        pcall(task.cancel, mineThread)
        mineThread = nil
    end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 2: INSTANT PICKUP (DescendantAdded + sweeper)
-- ════════════════════════════════════════════════════════════════
local pickupActive  = false
local pickupTotal   = 0
local pickupConn    = nil
local pickupSweep   = nil
local pickupRadius  = 0
local wantRune      = true
local wantCrystal   = true
local onPickStatus  = nil

local function pickupItem(tool)
    if not tool or not tool.Parent then return false end
    if isInInventory(tool) then return false end
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local handle = tool:FindFirstChild("Handle")
        or tool:FindFirstChildOfClass("BasePart")
        or tool:FindFirstChildOfClass("MeshPart")
        or tool:FindFirstChildOfClass("Part")

    -- Metode 1: firetouchinterest
    if hasFTI and handle then
        pcall(function()
            firetouchinterest(handle, hrp, 0)
            task.wait(0.02)
            firetouchinterest(handle, hrp, 1)
        end)
        task.wait(0.03)
        if isInInventory(tool) then return true end
    end

    -- Metode 2: Teleport HRP ke item
    if handle then
        pcall(function()
            local sv = hrp.CFrame
            hrp.CFrame = handle.CFrame * CFrame.new(0, 0.5, 0)
            task.wait(0.05)
            hrp.CFrame = sv
        end)
        task.wait(0.05)
        if isInInventory(tool) then return true end
    end

    -- Metode 3: Teleport item ke HRP
    if handle then
        pcall(function()
            for _ = 1, 3 do
                handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -1)
                task.wait(0.04)
                if isInInventory(tool) then break end
            end
        end)
        if isInInventory(tool) then return true end
    end

    -- Metode 4: Reparent paksa
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        pcall(function() tool.Parent = bp end)
        task.wait(0.03)
        if isInInventory(tool) then return true end
    end

    -- Metode 5: FireServer RemoteEvent pickup
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        for _, v in ipairs(rs:GetDescendants()) do
            if v:IsA("RemoteEvent") and
               (v.Name:lower():find("pickup") or
                v.Name:lower():find("collect") or
                v.Name:lower():find("grab")) then
                v:FireServer(tool); break
            end
        end
    end)

    return isInInventory(tool)
end

local function handleItem(item)
    if not pickupActive then return end
    if not item:IsA("Tool") then return end
    if isInInventory(item) then return end
    local ok = (wantRune and isRune(item)) or (wantCrystal and isCrystal(item))
    if not ok then return end

    if pickupRadius > 0 then
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local handle = item:FindFirstChildOfClass("BasePart")
                or item:FindFirstChildOfClass("MeshPart")
                or item:FindFirstChildOfClass("Part")
            if handle and (handle.Position - hrp.Position).Magnitude > pickupRadius then
                return
            end
        end
    end

    local success = pickupItem(item)
    if success then
        pickupTotal = pickupTotal + 1
        if onPickStatus then
            onPickStatus(string.format("🧲 [%s] total: %d", item.Name, pickupTotal))
        end
    end
end

local function sweepWorkspace()
    local function scanNode(node, depth)
        if depth > 8 then return end
        local ok, children = pcall(node.GetChildren, node)
        if not ok then return end
        for _, obj in ipairs(children) do
            if not pickupActive then return end
            if obj:IsA("Tool") and not isInInventory(obj) then
                task.spawn(handleItem, obj)
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scanNode(obj, depth+1)
            end
        end
    end
    scanNode(workspace, 0)
end

local function startPickup(wR, wC, radius, onStatus)
    if pickupActive then return end
    pickupActive = true
    pickupTotal  = 0
    wantRune     = wR
    wantCrystal  = wC
    pickupRadius = radius
    onPickStatus = onStatus

    -- Reaktif: langsung saat item muncul
    pickupConn = workspace.DescendantAdded:Connect(function(obj)
        task.spawn(handleItem, obj)
    end)

    -- Backup sweeper tiap 0.5 detik
    pickupSweep = task.spawn(function()
        while pickupActive do
            sweepWorkspace()
            if onStatus then
                onStatus(string.format("🧲 Aktif | radius %.0f | total: %d", pickupRadius, pickupTotal))
            end
            task.wait(0.5)
        end
    end)

    task.spawn(sweepWorkspace)
    if onStatus then onStatus("🟢 Instant Pickup aktif!") end
end

local function stopPickup()
    pickupActive = false
    if pickupConn  then pcall(function() pickupConn:Disconnect() end); pickupConn = nil end
    if pickupSweep then pcall(task.cancel, pickupSweep); pickupSweep = nil end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 3: Die-to-Drop
-- ════════════════════════════════════════════════════════════════
local function dieCharacter(onStatus)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        if onStatus then onStatus("❌ Humanoid tidak ditemukan!") end
        return
    end
    if onStatus then onStatus("💀 Mematikan karakter...") end
    pcall(function() hum.Health = 0 end)
    if hum.Health > 0 then pcall(function() hum:TakeDamage(math.huge) end) end
    if hum.Health > 0 then
        pcall(function()
            for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if v:IsA("RemoteEvent") and v.Name:lower():find("kill") then
                    v:FireServer(); break
                end
            end
        end)
    end
    task.wait(0.6)
    if onStatus then onStatus("✅ Karakter mati! Item di-drop ke lantai.") end
end

-- ════════════════════════════════════════════════════════════════
--  FITUR 4: Rune Dropper
-- ════════════════════════════════════════════════════════════════
local runeDropping = false

local function dropRunes(nameFilter, delayMs, onStatus)
    if runeDropping then return end
    runeDropping = true
    local runes = getInventory(function(t)
        if not isRune(t) then return false end
        if nameFilter and nameFilter ~= "" and nameFilter:lower() ~= "all" then
            return t.Name:lower():find(nameFilter:lower(), 1, true) ~= nil
        end
        return true
    end)
    if #runes == 0 then
        if onStatus then onStatus("⚠️ Tidak ada rune!") end
        runeDropping = false; return
    end
    local holdMs = math.max(math.floor(delayMs*0.4), 1)
    local waitMs = math.max(delayMs - holdMs, 1)
    local count  = 0
    for i, tool in ipairs(runes) do
        if not runeDropping then break end
        if tool and tool.Parent then
            if onStatus then onStatus(string.format("🔮 %d/%d → %s", i, #runes, tool.Name)) end
            if equipTool(tool) then
                task.wait(waitMs/1000)
                pressKey(Enum.KeyCode.Escape, holdMs)
                task.wait(waitMs/1000)
                count = count + 1
            end
        end
    end
    runeDropping = false
    if onStatus then onStatus(string.format("✅ %d rune di-drop.", count)) end
end

