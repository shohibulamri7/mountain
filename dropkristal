mkSec("🔮  FITUR 4 — Rune Dropper Cepat",60,PURPLE)
mkLbl("Equip → Escape bergantian. 1 ms per rune.",61)
local rune_d=mkInput("Delay (ms):", "1",   62)
local rune_f=mkInput("Filter ('all'):", "all",63)
local rune_st=mkSt(64)
mkBtn("🔮  DROP SEMUA RUNE",PURPLE,65,function()
    if runeDropping then rune_st.Text="⏳ Sedang berjalan..."; return end
    local d=math.max(tonumber(rune_d.Text) or 1, 1)
    local f=rune_f.Text or "all"
    task.spawn(function() dropRunes(f,d,function(s) rune_st.Text=s end) end)
end)
mkBtn("⛔  STOP Rune",Color3.fromRGB(70,70,90),66,function()
    runeDropping=false; rune_st.Text="■ Dihentikan."
end)
mkSep(67)

